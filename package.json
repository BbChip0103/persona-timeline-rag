{
  "private": true,
  "name": "persona-timeline-rag",
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "test": "NODE_OPTIONS=--max-old-space-size=8192 jest --runInBand --testPathIgnorePatterns packages/ops/test/langfuse.test.ts scripts/framework-evaluate.test.ts && pnpm test:otel",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit",
    "lint": "eslint packages apps/api apps/web scripts e2e --no-error-on-unmatched-pattern",
    "check": "pnpm test && pnpm typecheck && pnpm lint",
    "build:web": "pnpm --filter @ptr/web build",
    "dev:api": "tsx apps/api/src/main.ts",
    "dev:worker": "uv run --project apps/llm-service ptr-llm worker",
    "dev:web": "pnpm --filter @ptr/web dev",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "prepare:research": "tsx scripts/prepare-research.ts",
    "harness:smoke": "tsx scripts/harness-smoke.ts",
    "evaluate": "uv run --project apps/llm-service ptr-llm evaluate",
    "ops:check-env": "tsx packages/ops/scripts/check-env.ts",
    "ops:status": "tsx scripts/ops-status.ts",
    "framework:checkpoints": "tsx scripts/framework-checkpoints.ts",
    "framework:smoke": "tsx scripts/framework-smoke.ts",
    "framework:loadtest": "tsx scripts/framework-loadtest.ts",
    "framework:retention": "tsx scripts/framework-retention.ts",
    "test:otel": "NODE_OPTIONS=\"--experimental-vm-modules --max-old-space-size=8192\" jest --runInBand --runTestsByPath packages/ops/test/langfuse.test.ts scripts/framework-evaluate.test.ts",
    "framework:checkpoint-retention": "tsx scripts/framework-checkpoint-retention.ts",
    "framework:receipt-retention": "tsx scripts/framework-receipt-retention.ts",
    "evaluate:legacy": "tsx scripts/framework-evaluate.ts",
    "persona": "uv run --project apps/llm-service ptr-llm persona",
    "dev:worker:legacy": "PTR_LLM_SERVICE_MODE=legacy tsx apps/api/src/worker.ts",
    "llm:check": "uv run --project apps/llm-service pytest apps/llm-service/tests && uv run --project apps/llm-service ruff check apps/llm-service/src apps/llm-service/tests && uv run --project apps/llm-service mypy apps/llm-service/src"
  },
  "dependencies": {
    "@langchain/langgraph-checkpoint": "1.1.6",
    "@langchain/langgraph-checkpoint-postgres": "1.0.6",
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "express": "4.21.2",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.30",
    "@types/pg": "8.15.5",
    "@typescript-eslint/eslint-plugin": "8.48.1",
    "@typescript-eslint/parser": "8.48.1",
    "eslint": "9.39.1",
    "jest": "29.7.0",
    "ts-jest": "29.2.6",
    "tsx": "4.20.6",
    "typescript": "5.7.3"
  }
}
