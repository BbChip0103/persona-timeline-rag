{
  "private": true,
  "name": "persona-timeline-rag",
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "lint": "eslint packages apps/api apps/gateway scripts e2e --no-error-on-unmatched-pattern",
    "check": "pnpm test && pnpm typecheck && pnpm lint",
    "build:web": "pnpm --filter @ptr/web build",
    "dev:api": "tsx apps/api/src/main.ts",
    "dev:web": "pnpm --filter @ptr/web dev",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "prepare:research": "tsx scripts/prepare-research.ts",
    "harness:smoke": "tsx scripts/harness-smoke.ts",
    "evaluate": "tsx scripts/evaluate.ts"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.24.2",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "tsx": "4.20.6",
    "jest": "29.7.0",
    "ts-jest": "29.2.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.30",
    "@types/pg": "8.15.5",
    "@types/express": "5.0.3",
    "eslint": "9.39.1",
    "@typescript-eslint/parser": "8.48.1",
    "@typescript-eslint/eslint-plugin": "8.48.1",
    "@playwright/test": "1.56.1"
  }
}
