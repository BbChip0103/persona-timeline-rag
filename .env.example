# Production profile: the 19 variables of docs/configuration.md (check with `pnpm ops:check-env`).
# Blank secrets: scripts/db-init-env.ts creates a NEW isolated database config.
# Existing database password must not be replaced.
PTR_DB_PASSWORD=
DATABASE_URL=
PTR_REDIS_URL=
PTR_API_TOKEN=
PTR_UI_PASSWORD=
PTR_SESSION_SECRET=
# gateway (with PTR_GATEWAY_TOKEN and, for the gateway role, PTR_GATEWAY_UPSTREAMS_FILE) or openrouter (with PTR_MODEL).
PTR_CHAT_PROVIDER=gateway
PTR_GATEWAY_TOKEN=
PTR_GATEWAY_UPSTREAMS_FILE=
PTR_GATEWAY_FAILOVER=off
PTR_MODEL=google/gemini-3-flash-preview
PTR_PERSONAS_FILE=data/research/personas.json
# PTR_AUTHORED_PERSONAS_FILE=data/research/authored-personas.json
PTR_WORKER_CONCURRENCY=32
PTR_INTENT_CLASSIFIER=off
PTR_SAFETY_FILTER=off
# All three are needed when the openrouter provider, a jev helper or OpenRouter failover is on.
GOAL1_LIVE_ENABLED=false
GOAL1_ALLOW_EXTERNAL_DATA=false
OPENROUTER_API_KEY=
# 1 = demo layer (docs/demo-mode.md): scaling knobs, fake/selfhosted providers. Leave unset in production.
# PTR_DEMO_SCALING=1
