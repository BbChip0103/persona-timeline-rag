{
  "selection_file": "data/manifests/targets.json",
  "subset_root": "data/subsets/instagram",
  "normalized_posts": "data/processed/target_posts.jsonl",
  "max_people": 4,
  "human_review_sample_size": 50,
  "event_date_policy": "unknown unless supported by explicit evidence",
  "evaluation_baselines": [
    "model_less_lexical",
    "no_retrieval",
    "lexical_rag",
    "semantic_rag"
  ],
  "deferred_baselines": [
    "caption_image_rag",
    "web_search"
  ],
  "poc_goal": "influencer_persona_chat",
  "persona_definitions": "data/personas",
  "chat_evaluation_scenarios": 12,
  "user_turns_per_scenario": 5,
  "phases": [
    "character_chat_environment",
    "persona_chat_and_creative_baseline",
    "timeline_rag_and_comparison"
  ],
  "creative_baseline": {
    "retrieval_mode": "off",
    "post_briefs_per_person": 3,
    "image_briefs_per_person": 0,
    "image_provider": "disabled"
  }
}
