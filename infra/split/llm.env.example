# Copy to a distinct owner-only private file. No app/owner DB credential here.
PTR_LLM_DATABASE_URL=postgresql://ptr_split_llm:REPLACE@127.0.0.1:58432/ptr_split_research
PTR_LLM_REDIS_URL=redis://default:REPLACE@127.0.0.1:58479/0
PTR_LLM_BACKEND_URL=http://127.0.0.1:56441
PTR_LLM_CONTROL_TOKEN=REPLACE_DISTINCT_SHARED_CONTROL_TOKEN
PTR_LLM_QUEUE_NAME=turns
PTR_LLM_QUEUE_PREFIX=ptr
PTR_LLM_CONCURRENCY=4
PTR_LLM_HOST=127.0.0.1
PTR_LLM_PORT=58442
PTR_LLM_DB_POOL_MAX=8
PTR_LLM_PROVIDER=litellm
PTR_LLM_LITELLM_BASE_URL=http://127.0.0.1:36435/v1
PTR_LLM_LITELLM_API_KEY=REPLACE_WITH_SELECTED_PROXY_APP_KEY
PTR_LLM_MODEL=primary
PTR_LLM_LITELLM_BILLABLE=0
# Gateway-only private env file must define PTR_OPENROUTER_API_KEY when paid failover is enabled.
# Do not put PTR_OPENROUTER_API_KEY in this Python role env file.
PTR_LLM_MAX_OUTPUT_TOKENS=512
# LiteLLM defaults to 65536; direct OpenRouter defaults to 32768 when unset.
PTR_LLM_INPUT_BYTES=65536
PTR_LLM_MODEL_TIMEOUT_MS=30000
PTR_LLM_INTENT_CLASSIFIER=off
PTR_LLM_SAFETY_FILTER=off
PTR_LLM_JEV_TIMEOUT_MS=1500
PTR_LLM_SAFETY_TIMEOUT_MS=2500
PTR_LLM_JEV_MIN_CONFIDENCE=0.6
PTR_LLM_EMBEDDING_PROVIDER=off
# Summary retrieval uses vector similarity top 3 after index activation.
# Live calls still require approved credentials, external-data consent and budget.
PTR_LLM_RETRIEVAL_INDEX=legacy
LANGFUSE_ENABLED=false
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# Capacity spillover is opt-in and requires the cumulative ledger before EVERY primary call.
# A >=32-byte private secret shared ONLY with gateway; never commit a real value.
# PTR_LLM_CAPACITY_SPILLOVER_KEY=
# PTR_LLM_LITELLM_BILLABLE=1
# PTR_LLM_PROMPT_USD_PER_M=0.1
# PTR_LLM_COMPLETION_USD_PER_M=0.5
# PTR_LLM_MAX_CALL_MICROUSD=100000
