# Copy to an owner-only private file; replace placeholders. Never share this file with Python.
PTR_APP_DATABASE_URL=postgresql://ptr_split_app:REPLACE@127.0.0.1:58432/ptr_split_research
PTR_REDIS_URL=redis://default:REPLACE@127.0.0.1:58479/0
PTR_LLM_SERVICE_MODE=split
PTR_LLM_SERVICE_URL=http://127.0.0.1:58442
PTR_LLM_CONTROL_TOKEN=REPLACE_DISTINCT_SHARED_CONTROL_TOKEN
PTR_API_TOKEN=REPLACE_BACKEND_AND_WEB_TOKEN
PTR_API_SYNTHETIC_TOKEN=REPLACE_DISTINCT_SYNTHETIC_TOKEN
PTR_API_PORT=56441
PTR_TURN_QUEUE=turns
PTR_EVENTS_NAMESPACE=events
PTR_CHAT_PROVIDER=local
PTR_MODEL=REPLACE_WITH_SERVED_MODEL_ID
# Local-only Compose chat is not billable; leave the legacy billable switch unset.
# Do not put PTR_OPENROUTER_API_KEY or OPENROUTER_API_KEY in backend or web role env files.
PTR_LLM_SEMANTIC_SEARCH=0
PTR_DB_POOL_MAX=8
PTR_QUEUE_MAX_DEPTH=256
PTR_DISPATCH_INTERVAL_MS=1000
PTR_DISPATCH_GRACE_MS=2000
# Web-only values, never present in the LLM service environment.
PTR_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PTR_UI_PASSWORD=REPLACE_WITH_AT_LEAST_12_RANDOM_CHARACTERS
